{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "MyTasksContext": "Data Source=MyTasks.db"
  },
  "Jwt": {
    "Issuer": "MyTasksApi",
    "Audience": "MyTasksApiClient",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  }
}
