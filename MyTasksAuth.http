@baseUrl = https://localhost:7082

########## GUEST OPERATIONS ##########
### Placed first - {{guestToken}} is consumed by both the guest task requests below
### AND by the "log in as user" block further down, to test the claim-on-login flow.

###### Create a guest session - captures the token into {{guestToken}}
# @name guestSession
POST {{baseUrl}}/api/guest/session

###
@guestToken = {{guestSession.response.body.$.guestToken}}

### Create a task as a guest
POST {{baseUrl}}/api/tasks
Content-Type: application/json
X-Guest-Token: {{guestToken}}

{
    "title": "guest test",
    "description": "created without an account",
    "category": "test"
}

### Get tasks as a guest
GET {{baseUrl}}/api/tasks
Accept: application/json
X-Guest-Token: {{guestToken}}

### Delete a task as a guest
DELETE {{baseUrl}}/api/tasks/24
X-Guest-Token: {{guestToken}}


########## AUTH OPERATIONS ##########

### Register a new user (plain - does not claim any guest tasks)
### Use -> X-Guest-Token: {{guestToken}} if you want to claim any tasks created under the guest session.
POST {{baseUrl}}/api/auth/register
Content-Type: application/json

{
    "username": "guestToUser1",
    "email": "guestToUser1@test.local",
    "password": "guestToUser1"
}

###### Log in as Admin - captures the access token into {{authToken}} for every request below
# @name loginAdmin
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
    "username": "admin",
    "password": "!Admin123!"
}

###### Log in as user, presenting X-Guest-Token - claims any tasks created under
###### {{guestToken}} into this account, then invalidates the guest session.
# @name loginUser
POST {{baseUrl}}/api/auth/login
Content-Type: application/json
X-Guest-Token: {{guestToken}}

{
    "username": "guestToUser1",
    "password": "guestToUser1"
}

### Capture tokens from whichever login above you just ran (loginAdmin or loginUser)
@authToken = {{loginAdmin.response.body.$.accessToken}}
@refreshToken = {{loginAdmin.response.body.$.refreshToken}}

### Logout - revokes the refresh token used to log in above
POST {{baseUrl}}/api/auth/logout
Content-Type: application/json
Authorization: Bearer {{authToken}}

{
    "refreshToken": "{{refreshToken}}"
}


########## TASK OPERATIONS (as authenticated user) ##########

### Create a task
POST {{baseUrl}}/api/tasks
Content-Type: application/json
Authorization: Bearer {{authToken}}

{
    "title": "test",
    "description": "this is a test",
    "category": "test 1"
}

### Get all tasks
GET {{baseUrl}}/api/tasks
Accept: application/json
Authorization: Bearer {{authToken}}

### Filter tasks by category
GET {{baseUrl}}/api/tasks?category=General
Accept: application/json
Authorization: Bearer {{authToken}}

### Filter tasks by status
GET {{baseUrl}}/api/tasks?status=Pending
Accept: application/json
Authorization: Bearer {{authToken}}

### Search for tasks
GET {{baseUrl}}/api/tasks?search=test
Accept: application/json
Authorization: Bearer {{authToken}}

### Sort tasks
GET {{baseUrl}}/api/tasks?sortBy=dueDate&ascending=true
Accept: application/json
Authorization: Bearer {{authToken}}

### Pagination
GET {{baseUrl}}/api/tasks?limit=5&offset=0
Accept: application/json
Authorization: Bearer {{authToken}}

### Get a task by ID
GET {{baseUrl}}/api/tasks/22
Authorization: Bearer {{authToken}}

### Update a task
PUT {{baseUrl}}/api/tasks/22
Content-Type: application/json
Authorization: Bearer {{authToken}}

{
    "title": "future test",
    "description": "this is another test",
    "dueDate": "2287-11-11T04:50:58.4974874",
    "category": "test 2",
    "status": 1
}

### Delete a task
DELETE {{baseUrl}}/api/tasks/20
Authorization: Bearer {{authToken}}
